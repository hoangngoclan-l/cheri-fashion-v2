# Cấu hình máy chủ
PORT=3000

# Kết nối MySQL (XAMPP mặc định)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cheri_fashion

# Tạo chuỗi bí mật dài, ngẫu nhiên và không chia sẻ công khai
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# AI hỗ trợ khách hàng (khóa chỉ đặt ở backend .env, không đưa lên frontend/GitHub)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
